# Copia este archivo como ".env" en la raíz del proyecto (NO se sube a Git).
# docker-compose lo lee automáticamente. En el servidor debe tener permisos 600.
DB_USER=taskuser
DB_PASSWORD=cambia_esto_por_una_contrasena_fuerte
DB_NAME=tasksdb

# --- TLS (HTTPS con Let's Encrypt) ---
# nip.io resuelve automáticamente el subdominio a la IP que lleva en el nombre,
# así que no hace falta comprar dominio ni configurar DNS.
# Ejemplo para la IP 3.144.146.133:
TLS_DOMAIN=3-144-146-133.nip.io
CERTBOT_EMAIL=tu_correo@ejemplo.com

# --- Opcional ---
# Solo si alguna vez se consume la API desde OTRO origen (por defecto no se
# envía ninguna cabecera CORS, que es lo más seguro).
# CORS_ORIGIN=https://mi-otro-sitio.example
